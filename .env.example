# Copier ce fichier en .env et remplir les vraies valeurs.
# .env ne doit JAMAIS être commité (déjà dans .gitignore).

# Base de données
DB_USERNAME=postgres
DB_PASSWORD=change-me

# JWT — générer une chaîne aléatoire longue, ne jamais réutiliser celle du dev
JWT_SECRET_KEY=change-me-to-a-long-random-string

# Email transactionnel (Brevo SMTP)
BREVO_SMTP_LOGIN=your-brevo-smtp-login
BREVO_SMTP_KEY=your-brevo-smtp-key
MAIL_FROM=no-reply@your-domain.com

# Notification admin (MVP : une seule adresse)
ADMIN_NOTIFICATION_EMAIL=admin@your-domain.com

# URL du frontend, utilisée dans les liens de vérification d'email
FRONTEND_URL=http://localhost:3000

# update en local, validate recommandé en production une fois le schéma stable
HIBERNATE_DDL_MODE=update
